{
    "title": "Reverse Shell Generator",
    "icon": "icon.png",
    "layout": [
        {
            "type": "section",
            "label": "Target Configuration",
            "fields": [
                {
                    "id": "lhost",
                    "type": "text",
                    "label": "Listener IP",
                    "placeholder": "192.168.1.100",
                    "default": "",
                    "required": true,
                    "validator": "ip_address",
                    "tooltip": "The IP address where your listener is running (attacker machine)"
                },
                {
                    "id": "lport",
                    "type": "number",
                    "label": "Listener Port",
                    "placeholder": "4444",
                    "default": 4444,
                    "min": 1,
                    "max": 65535,
                    "required": true,
                    "tooltip": "TCP port the listener is bound to (1-65535)"
                },
                {
                    "id": "protocol",
                    "type": "dropdown",
                    "label": "Protocol Transport",
                    "options": ["TCP", "HTTP", "DNS", "ICMP", "WebSocket"],
                    "default": "TCP",
                    "tooltip": "Transport protocol for the reverse connection"
                }
            ]
        },
        {
            "type": "section",
            "label": "Payload Options",
            "fields": [
                {
                    "id": "payload_type",
                    "type": "dropdown",
                    "label": "Output Language",
                    "options": [
                        "python",
                        "powershell",
                        "bash",
                        "c",
                        "go",
                        "nim",
                        "rust"
                    ],
                    "default": "python",
                    "tooltip": "Target language for the generated payload"
                },
                {
                    "id": "encrypt",
                    "type": "checkbox",
                    "label": "Encrypt with AES-256",
                    "default": false,
                    "tooltip": "Wrap payload in AES-256 encryption using Fernet (requires cryptography library)"
                },
                {
                    "id": "obfuscate",
                    "type": "slider",
                    "label": "Obfuscation Level",
                    "min": 0,
                    "max": 10,
                    "default": 5,
                    "tooltip": "0 = none, 1-3 = comment stripping, 4-6 = dead code, 7-9 = heavy transform, 10 = max"
                }
            ]
        },
        {
            "type": "actions",
            "buttons": [
                {
                    "id": "generate",
                    "label": "Generate Payload",
                    "style": "primary",
                    "action": "run",
                    "tooltip": "Generate the reverse shell payload with current settings"
                },
                {
                    "id": "test",
                    "label": "Test Connection",
                    "style": "secondary",
                    "action": "custom",
                    "handler": "test_connection",
                    "tooltip": "Test if the target host:port is reachable"
                },
                {
                    "id": "copy",
                    "label": "Copy to Clipboard",
                    "style": "secondary",
                    "action": "custom",
                    "handler": "copy_payload",
                    "tooltip": "Copy the generated payload to the system clipboard"
                }
            ]
        }
    ],
    "output_display": {
        "type": "tabs",
        "tabs": [
            {
                "label": "Raw Payload",
                "type": "code",
                "language": "python",
                "readonly": true,
                "wrap": false
            },
            {
                "label": "Base64 Encoded",
                "type": "code",
                "language": "text",
                "readonly": true,
                "wrap": true
            },
            {
                "label": "Hex Dump",
                "type": "hex",
                "readonly": true,
                "bytes_per_line": 16
            },
            {
                "label": "Metadata",
                "type": "table",
                "fields": [
                    "status",
                    "size_bytes",
                    "encrypted",
                    "protocol",
                    "obfuscation_level",
                    "generation_time_ms"
                ]
            }
        ]
    },
    "metadata": {
        "author": "sec_anonymous",
        "version": "2.1.0",
        "category": "exploitation",
        "tags": ["reverse-shell", "tcp", "encrypted", "payload-generation"]
    }
                }
